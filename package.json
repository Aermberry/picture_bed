{
  "name": "picbed",
  "version": "0.4.1",
  "description": "Local CLI + Web console: extract images from markdown/html, upload to PicX-style GitHub image host, rewrite links",
  "author": "Aermberry",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aermberry/picture_bed.git"
  },
  "bugs": {
    "url": "https://github.com/Aermberry/picture_bed/issues"
  },
  "homepage": "https://github.com/Aermberry/picture_bed#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "picbed": "bin/picbed.js",
    "picbed-mcp": "bin/picbed-mcp.js"
  },
  "main": "desktop/main.mjs",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "picbed": "node ./bin/picbed.js",
    "openspec": "openspec",
    "validate": "node scripts/validate.mjs",
    "validate:design": "node scripts/validate.mjs --profile=design",
    "validate:bootstrap": "node scripts/validate.mjs --profile=bootstrap",
    "validate:ci": "node scripts/validate.mjs --profile=design,scripts",
    "desktop:dev": "tsc -p tsconfig.json && node scripts/desktop-dev.mjs",
    "desktop:bundle": "tsc -p tsconfig.json && electron-vite build",
    "desktop:dist": "tsc -p tsconfig.json && electron-vite build && node scripts/build-desktop.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "image-host",
    "picx",
    "github",
    "markdown",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@fission-ai/openspec": "^1.13.2",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "esbuild@0.25.12": true
  }
}
