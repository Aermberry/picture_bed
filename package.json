{
  "name": "picbed",
  "version": "0.2.0",
  "description": "Local CLI: extract images from markdown/html, upload to PicX-style GitHub image host, rewrite links",
  "type": "module",
  "bin": {
    "picbed": "./bin/picbed.js",
    "picbed-mcp": "./bin/picbed-mcp.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "picbed": "node ./bin/picbed.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "image-host",
    "picx",
    "github",
    "markdown",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
